# Almanook configuration. Copy to .env (git-ignored) and adjust. Never commit real credentials.

# --- Database (PostgreSQL) ---
POSTGRES_DB=almanook
POSTGRES_USER=almanook
POSTGRES_PASSWORD=change-me-local-only
# Host port for the database container (used by `make infra` + `make backend`)
POSTGRES_PORT=5432
# JDBC settings used by the backend; Docker Compose overrides the host for the container network
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/almanook
SPRING_DATASOURCE_USERNAME=almanook
SPRING_DATASOURCE_PASSWORD=change-me-local-only

# --- Backend ---
SERVER_PORT=8080
# Host port of the backend container in `docker compose up`
BACKEND_PORT=8080
# true behind HTTPS (marks the session cookie Secure)
ALMANOOK_SECURE_COOKIES=false
# OpenAPI JSON and Swagger UI at /v3/api-docs and /swagger-ui.html
ALMANOOK_API_DOCS_ENABLED=true

# --- Local single-user convenience (do not enable on a public server) ---
ALMANOOK_DEMO_USER_ENABLED=true
ALMANOOK_DEMO_USER_EMAIL=demo@almanook.app
ALMANOOK_DEMO_USER_PASSWORD=change-me-demo-password
ALMANOOK_DEMO_USER_NAME=Demo

# --- AI enrichment (Anthropic Claude or Google Gemini). Leave both keys empty to run without AI. ---
# auto (Anthropic if its key is set, otherwise Gemini) | anthropic | gemini | none
ALMANOOK_AI_PROVIDER=auto

# Google Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ALMANOOK_GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high
ALMANOOK_GEMINI_THINKING_LEVEL=low
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Anthropic Claude
ANTHROPIC_API_KEY=
ALMANOOK_AI_MODEL=claude-opus-5-5
# low | medium | high (higher = more thorough, slower, more tokens)
ALMANOOK_AI_EFFORT=low
ALMANOOK_AI_MAX_SEARCHES=4
# Server-side refusal fallback (Claude API beta); set false if your account or gateway rejects it
ALMANOOK_AI_REFUSAL_FALLBACK=true
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Cover images ---
# Wikimedia Commons needs no key
ALMANOOK_WIKIMEDIA_ENABLED=true
# Optional: https://unsplash.com/developers (Access Key, not the Secret Key)
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=almanook

# --- Frontend ---
# Host port of the web container in `docker compose up` (nginx serves the SPA and proxies /api)
WEB_PORT=3000
# Backend URL the Vite dev server proxies /api to (`make frontend`)
ALMANOOK_BACKEND_URL=http://localhost:8080
